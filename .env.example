POSTGRES_URL=postgresql://user:password@localhost:5432/skarb-web-db

# JWT auth (>= 32 chars each, distinct values; e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-chars

PASSWORD_SALT_ROUNDS=12
